--!strict
local RS=game:GetService('ReplicatedStorage')
local W=game:GetService('Workspace')
local Lighting=game:GetService('Lighting')
local Config=require(RS.NewLife.Shared.Config.WorldFoundationConfig)
local T={Name='Phase11_OpenWorld_Foundation'}
function T.Run()
 local pass,fail,errs=0,0,{}
 local function check(id,cond,msg) if cond then pass+=1 else fail+=1;table.insert(errs,id..' '..(msg or 'FAIL')) end end
 local root=W.NewLife.World:FindFirstChild('OpenWorldFoundation')
 check('T11_1100',Config.Version=='1.2.0-open-world-foundation','version')
 local kc=0;for _ in pairs(Config.KingdomAnchors) do kc+=1 end;check('T11_1101',kc==5,'kingdom count')
 check('T11_1102',Config.VerticalSlice=='VerdantReign','vertical slice')
 check('T11_1103',root~=nil,'foundation root')
 check('T11_1104',root and root:FindFirstChild('Settlement')~=nil,'settlement')
 check('T11_1105',root and root.Roads:FindFirstChild('SilverrunBridge')~=nil,'bridge')
 check('T11_1106',root and #root.Roads:GetChildren()>=6,'roads')
 check('T11_1107',root and #root.Vegetation:GetChildren()>=60,'vegetation')
 check('T11_1108',root and #root.Water:GetChildren()>=2,'water')
 check('T11_1109',root and root.Landmarks:FindFirstChild('WorldTree')~=nil,'world tree')
 check('T11_1110',root and root.Landmarks:FindFirstChild('MossfallRuins')~=nil,'ruins')
 check('T11_1111',root and root.Landmarks:FindFirstChild('ForbiddenSpire')~=nil,'forbidden landmark')
 check('T11_1112',root and #root.KingdomMarkers:GetChildren()==5,'kingdom markers')
 check('T11_1113',root and #root.BuildingKit:GetChildren()>=4,'building kit')
 check('T11_1114',root and root.Settlement:FindFirstChild('Inn')~=nil,'inn')
 check('T11_1115',root and root.Settlement:FindFirstChild('Blacksmith')~=nil,'blacksmith')
 check('T11_1116',root and root.Settlement:FindFirstChild('Church')~=nil,'church')
 check('T11_1117',root and root.Settlement:FindFirstChild('QuestBoard')~=nil,'quest space')
 check('T11_1118',#Config.LocalizationLocales==6,'locales')
 check('T11_1119',Config.Biomes.Grasslands~=nil and Config.Biomes.Forest~=nil and Config.Biomes.RiverLake~=nil and Config.Biomes.RockyHighlands~=nil,'core biomes')
 check('T11_1120',Config.Biomes.Snow.Future==true and Config.Biomes.Desert.Future==true and Config.Biomes.Swamp.Future==true,'future biomes')
 check('T11_1121',root and #root.EnemyZones:GetChildren()==3,'enemy zones')
 local e=W.NewLife:FindFirstChild('DungeonEntrance');check('T11_1122',e and (e.Position-Config.DungeonEntrance.Position).Magnitude<1,'dungeon entrance')
 check('T11_1123',root and #root.Ambience:GetChildren()==#Config.AmbienceHooks,'ambience hooks')
 check('T11_1124',root and #root.VFX:GetChildren()>=2,'vfx hooks')
 check('T11_1125',Lighting:FindFirstChild('NewLifeAtmosphere')~=nil,'atmosphere')
 check('T11_1126',Lighting:FindFirstChild('NewLifeColorGrade')~=nil,'color grade')
 check('T11_1127',Lighting:FindFirstChild('NewLifeBloom')~=nil,'bloom')
 check('T11_1128',W.StreamingEnabled==true,'streaming')
 local sp=W:FindFirstChildOfClass('SpawnLocation');check('T11_1129',sp and sp:GetAttribute('Region')=='Oakhaven','spawn')
 check('T11_1130',root and (root:GetAttribute('FoundationParts') or 9999)<=Config.Performance.FoundationPartBudget,'part budget')
 check('T11_1131',root and (root:GetAttribute('TreeCount') or 9999)<=Config.Performance.VegetationBudget,'vegetation budget')
 check('T11_1132',Config.ForbiddenNation.Future==true and Config.ForbiddenNation.HighRisk==true,'forbidden metadata')
 check('T11_1133',Config.DungeonEntrance.Region=='MossfallRuins','dungeon region')
 check('T11_1134',root and root:GetAttribute('ServerAuthoritative')==true,'server authority marker')
 return pass,fail,errs
end
return T
