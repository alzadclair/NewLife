--!strict
local RS=game:GetService('ReplicatedStorage'); local C=require(RS.NewLife.Shared.Config.ContentDefinitions); local S={_data=nil,_skills=nil,_cooldowns={}}
local function modelOf(t) if typeof(t)~='Instance' then return nil end return t:IsA('Model') and t or t:FindFirstAncestorOfClass('Model') end
function S:Start(data,skills) self._data=data; self._skills=skills end
function S:Cast(p,id,target) local pr=self._data:GetProfile(p); local c=p.Character; local def=C.Magic[id]; if not pr or not c or not def or not pr.Build.Unlocked[id] then return false,'Locked' end if not pr.Progression.HasMagic then return false,'NoMagic' end local root=c:FindFirstChild('HumanoidRootPart'); local m=modelOf(target); local tr=m and m:FindFirstChild('HumanoidRootPart'); local hum=m and m:FindFirstChildOfClass('Humanoid'); if not root or not tr or not hum or hum.Health<=0 or (root.Position-tr.Position).Magnitude>def.Range then return false,'Range' end local cds=self._cooldowns[p] or {}; self._cooldowns[p]=cds; local now=os.clock(); if now-(cds[id] or 0)<def.Cooldown then return false,'Cooldown' end local mana=c:GetAttribute('Mana') or 0; if mana<def.Cost then return false,'Resource' end c:SetAttribute('Mana',mana-def.Cost); cds[id]=now; hum:TakeDamage(def.Damage); if self._skills and self._skills._combat and self._skills._combat._enemyService and m then self._skills._combat._enemyService:MarkHit(m,p) end; self._skills:GainMastery(p,id,def.MasteryGain); self._data:Apply(p); return true,'OK' end
return S
