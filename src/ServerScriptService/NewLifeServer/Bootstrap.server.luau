--!strict
local services = script.Parent:WaitForChild('Services')
local StateService = require(services.StateService)
local PlayerDataService = require(services.PlayerDataService)
local ProgressionService = require(services.ProgressionService)
local SkillService = require(services.SkillService)
local MagicService = require(services.MagicService)
local QuestService = require(services.QuestService)
local DungeonService = require(services.DungeonService)
local CharacterService = require(services.CharacterService)
local EnemyService = require(services.EnemyService)
local CombatService = require(services.CombatService)
local NetworkService = require(services.NetworkService)
local WorldService = require(services.WorldService)
local WorldFoundationService = require(services.WorldFoundationService)
local PartyService = require(services.PartyService)
local GuildService = require(services.GuildService)
local ChatService = require(services.ChatService)
local RulerService = require(services.RulerService)
local WorldBossService = require(services.WorldBossService)
local RareContentService = require(services.RareContentService)
local EconomyService = require(services.EconomyService)
local TradeService = require(services.TradeService)
local MarketService = require(services.MarketService)

PlayerDataService:Start()
ProgressionService:Start(PlayerDataService)
QuestService:Start(PlayerDataService)
CharacterService:Start(PlayerDataService, StateService, ProgressionService)
CombatService:Start(StateService, CharacterService, nil)
SkillService:Start(PlayerDataService, CombatService)
MagicService:Start(PlayerDataService, SkillService)
DungeonService:Start(PlayerDataService, EnemyService)
EnemyService:Start(StateService, CombatService, ProgressionService, QuestService, DungeonService, GuildService)
CombatService._enemyService = EnemyService

WorldService:Start(PlayerDataService, CombatService, EnemyService, QuestService)
RareContentService:Start(PlayerDataService, WorldService)
EconomyService:Start(PlayerDataService, RulerService)
TradeService:Start(PlayerDataService, EconomyService, RareContentService)
MarketService:Start(PlayerDataService, EconomyService, RareContentService, RulerService, TradeService)
PartyService:Start(PlayerDataService)
GuildService:Start(PlayerDataService)
ChatService:Start(PlayerDataService, PartyService, GuildService)
RulerService:Start(PlayerDataService, WorldService, GuildService)
WorldBossService:Start(PlayerDataService, WorldService, RulerService, CombatService)
CombatService._worldBossService = WorldBossService
DungeonService:Configure(WorldBossService, WorldService, RareContentService)
WorldFoundationService:Start(EnemyService, DungeonService, WorldService)
NetworkService:Start(PlayerDataService, StateService, CharacterService, CombatService, ProgressionService, QuestService, DungeonService, SkillService, MagicService, WorldService, PartyService, GuildService, ChatService, RulerService, RareContentService, EconomyService, TradeService, MarketService)

print('[NewLife] FASE 13 economy, trading and markets online')
